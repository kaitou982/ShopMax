# ShopMax 环境变量配置
# 复制此文件为 .env 并填入实际值
# .env 文件已被 .gitignore 排除，不会提交到版本库

# ============ 数据库 ============
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopmax
DB_USERNAME=root
DB_PASSWORD=your-database-password

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ Nacos ============
NACOS_SERVER_ADDR=localhost:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-nacos-password

# ============ JWT ============
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# ============ QQ 邮箱 ============
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-mail-auth-code

# ============ MinIO ============
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-secret-key

# ============ 支付宝沙箱 ============
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# ============ AI 客服 ============
AI_MIMO_API_KEY=sk-xxx
AI_MIMO_BASE_URL=https://api.xiaomimimo.com

# ============ 快递100 ============
KDNIAO_CUSTOMER_ID=
KDNIAO_APP_KEY=

# ============ 高德地图 ============
AMAP_WEB_KEY=

# ============ CDN 静态加速 ============
# 前端静态资源CDN地址，例如 https://cdn.example.com/shopmax/
# 留空则使用相对路径 /
VITE_CDN_URL=

# ============ XXL-JOB ============
XXL_JOB_ADMIN_ADDR=http://localhost:8095/xxl-job-admin
XXL_JOB_TOKEN=

# ============ RocketMQ ============
ROCKETMQ_NAMESRV=localhost:9876

# ============ Elasticsearch ============
ES_URIS=localhost:9200

# ============ Seata 分布式事务 ============
SEATA_ENABLED=false
SEATA_SERVER=127.0.0.1:8093
